# Telegram
API_ID=12345
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF...

# Allowed chat IDs (comma separated) - only these users can trigger tasks
ALLOWED_USERS=123456789,987654321

# Your upload API (the existing backend you already built)
UPLOAD_API_URL=https://animez.mqzz.site/api/upload
UPLOAD_API_KEY=your_api_key_here

# Callback URL - where to POST when upload is done
CALLBACK_URL=https://animez.mqzz.site/api/callback

# Search settings
MAX_SEARCH_RESULTS=10
SEARCH_LANGUAGES=en,zh,hi

# Downloads
DOWNLOAD_DIR=/home/runner/workspace/anime-upload-agent/downloads
MAX_FILE_SIZE_MB=500
